{
  "name": "dsh-desktop-mcp-bridge",
  "version": "0.2.1-rc3-windows.6",
  "description": "Unofficial, opt-in MCP bridge to an existing official DeepSeek Harness Desktop runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.3"
  },
  "bin": {
    "dsh-desktop-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/desktop-plugin.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "format:check": "prettier --check src tests scripts .github *.json *.md examples docs locale cordis.patch.yml icon.svg --ignore-unknown .agents plugins --ignore-path .prettierignore",
    "format": "prettier --write src tests scripts .github *.json *.md examples docs locale cordis.patch.yml icon.svg --ignore-unknown .agents plugins --ignore-path .prettierignore",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "test:compatibility": "npm run build && node scripts/test-compatibility.mjs",
    "verify:npm": "node scripts/verify-npm-install.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.19.0",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "prettier": "3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@deepseek-ai/cordis-plugin-logger-console": "1.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.20",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "author": {
    "name": "Cryocell77",
    "url": "https://github.com/Cryocell77"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linglanxin/codex-dsh-bridge.git"
  },
  "homepage": "https://github.com/linglanxin/codex-dsh-bridge#readme",
  "bugs": {
    "url": "https://github.com/linglanxin/codex-dsh-bridge/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "codex",
    "deepseek",
    "deepseek-harness",
    "desktop",
    "subagent",
    "dsh-plugin"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "next"
  }
}
